    <worksheet name='Total Orders'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#0859bb' fontname='Tableau Bold' fontsize='10'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='global_ecommerce_cleaned' name='federated.04qrlz01riewjj1a5t1t41wuni0z' />
          </datasources>
          <datasource-dependencies datasource='federated.04qrlz01riewjj1a5t1t41wuni0z'>
            <column caption='Orders YoY % Final' datatype='real' name='[Calculation_0252653320019968]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;SUM(IF YEAR([date]) = 2025 THEN [orders] END)&#13;&#10;-&#13;&#10;SUM(IF YEAR([date]) = 2024 THEN [orders] END)&#13;&#10;)&#13;&#10;/&#13;&#10;SUM(IF YEAR([date]) = 2024 THEN [orders] END)' />
            </column>
            <column caption='Date' datatype='date' name='[date]' role='dimension' type='ordinal' />
