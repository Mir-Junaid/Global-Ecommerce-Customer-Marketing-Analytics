      <column caption='Revenue % Change' datatype='real' name='[Calculation_0110266141773824]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([revenue]) - LOOKUP(SUM([revenue]), -1))&#13;&#10;/&#13;&#10;LOOKUP(SUM([revenue]), -1)'>
